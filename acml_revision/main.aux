\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Paired molecular active-learning protocol.} Five TDC ADMET tasks are canonicalized, deduplicated, and divided by a fixed Bemis--Murcko scaffold split. Matched ECFP4 and RDKit2D representations are evaluated with four learners. Starting from 32 labeled molecules, the system acquires batches of 16 by random, entropy, or entropy--diversity selection, refits the learner, and evaluates on an untouched test set through a budget of 256 labels.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:pipeline}{{1}{2}{\textbf {Paired molecular active-learning protocol.} Five TDC ADMET tasks are canonicalized, deduplicated, and divided by a fixed Bemis--Murcko scaffold split. Matched ECFP4 and RDKit2D representations are evaluated with four learners. Starting from 32 labeled molecules, the system acquires batches of 16 by random, entropy, or entropy--diversity selection, refits the learner, and evaluates on an untouched test set through a budget of 256 labels}{figure.1}{}}
