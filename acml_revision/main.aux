\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Representation effects on label efficiency.} (a) Macro normalized AULC averaged over policies, datasets, and seeds. (b) Mean paired RDKit2D-minus-ECFP4 AULC effects for every model--policy condition; bars are 95\% paired-bootstrap confidence intervals over 50 matched endpoint--seed trajectories. Unlike the earlier boxplot, panel (b) depicts uncertainty in the mean effect relevant to the central claim.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:main}{{2}{6}{\textbf {Representation effects on label efficiency.} (a) Macro normalized AULC averaged over policies, datasets, and seeds. (b) Mean paired RDKit2D-minus-ECFP4 AULC effects for every model--policy condition; bars are 95\% paired-bootstrap confidence intervals over 50 matched endpoint--seed trajectories. Unlike the earlier boxplot, panel (b) depicts uncertainty in the mean effect relevant to the central claim}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Endpoint heterogeneity limits the macro conclusion}{6}{subsection.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Representation-by-model interaction.} Change from ECFP4 to RDKit2D in the paired TabPFN-minus-tree AULC contrast. Positive values mean that RDKit2D benefits TabPFN more than the indicated comparator. Intervals use 50 matched endpoint--seed trajectories for each acquisition policy.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:interaction}{{3}{7}{\textbf {Representation-by-model interaction.} Change from ECFP4 to RDKit2D in the paired TabPFN-minus-tree AULC contrast. Positive values mean that RDKit2D benefits TabPFN more than the indicated comparator. Intervals use 50 matched endpoint--seed trajectories for each acquisition policy}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Endpoint heterogeneity in representation gains.} Each box summarizes 120 paired RDKit2D-minus-ECFP4 AULC differences (four learners, three policies, and ten seeds); whiskers extend to 1.5 IQR. This distributional view is retained from the original paper, while Figure\nobreakspace  {}\ref  {fig:main} provides confidence intervals for the mean macro effects.}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:endpoints}{{4}{7}{\textbf {Endpoint heterogeneity in representation gains.} Each box summarizes 120 paired RDKit2D-minus-ECFP4 AULC differences (four learners, three policies, and ten seeds); whiskers extend to 1.5 IQR. This distributional view is retained from the original paper, while Figure~\ref {fig:main} provides confidence intervals for the mean macro effects}{figure.4}{}}
